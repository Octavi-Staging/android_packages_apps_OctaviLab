<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">
    
    <!-- Left Wallpaper View with Clock -->
    <com.android.utils.aboutWallpaperView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="16dp" />

    <!-- Right Side Navigation -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            
            <!-- Gesture Button -->
            <ImageButton
                android:id="@+id/gesture_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_gesture"
                app:tint="@android:color/black"
                android:contentDescription="@null" />

            <!-- Themes Button -->
            <ImageButton
                android:id="@+id/themes_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_theme"
                app:tint="@android:color/black"
                android:contentDescription="@null" />

            <!-- Misc Button -->
            <ImageButton
                android:id="@+id/misc_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_misc"
                app:tint="@android:color/black"
                android:contentDescription="@null" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
